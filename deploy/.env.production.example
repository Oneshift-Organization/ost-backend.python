# ─── Produção — copie para .env e preencha todos os campos ─────────────────
# NÃO commite este arquivo com valores reais.
# Defina como variáveis de ambiente no servidor/container.

# ─── App ────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
# gere com: openssl rand -hex 32
SECRET_KEY=GERAR_COM_OPENSSL_RAND_HEX_32
AUTH_ENABLED=true
# lista de domínios autorizados — NUNCA use *
CORS_ORIGINS=["https://app.oneshift.com.br","https://admin.oneshift.com.br"]
MAX_UPLOAD_SIZE_MB=50

# ─── Banco de Dados ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<dbname>
DB_POOL_SIZE=10
DB_ECHO=false

# ─── Supabase (Auth JWT RS256) ───────────────────────────────────────────────
SUPABASE_URL=https://<seu-projeto>.supabase.co
SUPABASE_ANON_KEY=<anon-key-do-painel-supabase>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-do-painel-supabase>
SUPABASE_JWT_AUDIENCE=authenticated

# ─── LLM — escolha um provider e configure apenas ele ───────────────────────
# Opções: anthropic | gemini | openrouter | mock (apenas testes)
LLM_PROVIDER=anthropic

# Anthropic (recomendado em produção)
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Gemini (alternativo)
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (alternativo free-tier)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free

# ─── Criptografia de credenciais cloud no banco ──────────────────────────────
# gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLOUD_CREDS_FERNET_KEY=GERAR_COM_FERNET_GENERATE_KEY

# ─── Credenciais Cloud (para sync de catálogo de preços) ─────────────────────
# Deixe vazio no MVP — necessário apenas para workers de sync de pricing

# GCP (catalog sync via Cloud Billing API)
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-service-account.json

# AWS (Price List API)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Azure (Retail Prices API)
# AZURE_SUBSCRIPTION_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# OCI (price list)
# OCI_USER_OCID=
# OCI_TENANCY_OCID=
# OCI_FINGERPRINT=
# OCI_REGION=

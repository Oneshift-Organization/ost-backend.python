# ─── App ──────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=changeme_use_openssl_rand_hex_32

# Dev-only: set to false to bypass JWT auth (every request → user 0000…0001).
# Hard-blocked in production by get_current_user even if false here.
AUTH_ENABLED=true

# Swagger (/docs), ReDoc (/redoc) e /openapi.json. Ligados em todos os ambientes,
# produção inclusive — o time do agente/MCP consome o contrato daqui.
DOCS_ENABLED=true

# ─── Database (OCI compartilhado em dev) ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:pass@<oci-host>:5432/oneshift_dev
DB_POOL_SIZE=10
DB_ECHO=false

# ─── Supabase ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
# Opcional: JWKS JSON pré-buscado para evitar fetch de rede em dev/CI.
# Buscar em: {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Em produção deixar vazio (busca automática na URL acima).
SUPABASE_JWKS_JSON=

# ─── Fluxo MCP + Agente (o interruptor) ───────────────────────────────────
# Com `false` (default) as rotas /v1/agent/* respondem 404 como se não
# existissem. Ligar NÃO desliga o legado — os dois convivem, e a virada real é
# o consumidor parar de chamar o caminho antigo. Reverter é mudar aqui e
# reiniciar: sem migration, sem deploy de código.
AGENT_FLOW_ENABLED=false

# ─── Preços de nuvem (sync offline) ───────────────────────────────────────
# Azure, OCI e AWS publicam preço sem autenticação. O GCP não: a Cloud Billing
# Catalog API recusa chamador anônimo (403). Sem esta key o sync do GCP devolve
# vazio e registra o motivo — os demais provedores continuam funcionando.
# É API key de projeto (não service account), com a Cloud Billing API habilitada.
GCP_BILLING_API_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","https://dev.oneshift.com.br","https://oneshift.com.br"]

# ─── RabbitMQ / Celery ────────────────────────────────────────────────────
CELERY_BROKER_URL=amqp://oneshift:oneshift@localhost:5672/oneshift
CELERY_RESULT_BACKEND=rpc://

# ─── Encryption envelope (cifrar credenciais cloud no DB) ─────────────────
CLOUD_CREDS_FERNET_KEY=

# ─── Cloud credentials (em prod: Vault) ───────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GCP_SERVICE_ACCOUNT_JSON=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
OCI_USER_OCID=
OCI_TENANCY_OCID=
OCI_FINGERPRINT=
OCI_REGION=

# ─── Provedor de IA ───────────────────────────────────────────────────────
# Modelo principal. Valores: gemini, openrouter, anthropic, nvidia ou mock.
# No ambiente develop, mantenha Claude como principal.
LLM_PROVIDER=anthropic

# Fallback usado somente quando o Claude falhar por indisponibilidade,
# limite de créditos, rate limit ou resposta inválida.
# Valores permitidos: none ou nvidia.
LLM_FALLBACK_PROVIDER=nvidia

# ─── Anthropic / Claude ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── NVIDIA NIM ───────────────────────────────────────────────────────────
# A NVIDIA funciona como fallback; ela não substitui o Claude normalmente.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TIMEOUT_SECONDS=300

# ─── Geração de Terraform (o interruptor) ─────────────────────────────────
# Com `false` (default) as rotas /v1/terraform-generations respondem 404 como se
# não existissem. A API gera CÓDIGO: nunca recebe credencial de nuvem, nunca roda
# `terraform plan` nem `apply`.
TERRAFORM_GENERATION_ENABLED=false

# `terraform validate` contra o schema real do provider — vê o que o `fmt` não
# vê (atributo inexistente, tipo errado). Desligado por escopo, não por custo:
# medido em 13/09/2026, com cache quente o init leva 0,86s e o validate 0,35s.
# Ligar exige o binário na imagem e TF_PLUGIN_CACHE_DIR num volume persistente —
# sem o cache, cada geração baixaria ~99 MB e o código recusa validar.
TERRAFORM_VALIDATE_ENABLED=false
TERRAFORM_CLI_TIMEOUT_SECONDS=120

# Escala em que os prompts do MCP pedem o viability_score. A API publica sempre
# 0..1000; esta variável diz o que o prompt pediu, para a conversão ser
# determinística em vez de deduzida pela magnitude do valor.
MCP_VIABILITY_SCALE=0-100

# ─── Servidor MCP de prompts ──────────────────────────────────────────────
# O MCP é aplicado à tentativa da NVIDIA. O caminho normal do Claude continua
# sem alteração e não carrega estes prompts.
MCP_PROMPTS_ENABLED=true
MCP_URL=https://mcp-dev.oneshift.com.br/mcp
MCP_TOKEN=
MCP_TIMEOUT_SECONDS=30
MCP_PROMPT_CACHE_SECONDS=300

# ─── Gemini (LLM para análise de migração) ────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── OpenRouter (LLM alternativo) ─────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ─── App ──────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=changeme_use_openssl_rand_hex_32

# Dev-only: set to false to bypass JWT auth (every request → user 0000…0001).
# Hard-blocked in production by get_current_user even if false here.
AUTH_ENABLED=true

# Swagger (/docs), ReDoc (/redoc) e /openapi.json. Ligados em todos os ambientes,
# produção inclusive — o time do agente/MCP consome o contrato daqui.
DOCS_ENABLED=true

# ─── Database (OCI compartilhado em dev) ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:pass@<oci-host>:5432/oneshift_dev
DB_POOL_SIZE=10
DB_ECHO=false

# ─── Supabase ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
# Opcional: JWKS JSON pré-buscado para evitar fetch de rede em dev/CI.
# Buscar em: {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Em produção deixar vazio (busca automática na URL acima).
SUPABASE_JWKS_JSON=

# ─── Preços de nuvem (sync offline) ───────────────────────────────────────
# Azure, OCI e AWS publicam preço sem autenticação. O GCP não: a Cloud Billing
# Catalog API recusa chamador anônimo (403). Sem esta key o sync do GCP devolve
# vazio e registra o motivo — os demais provedores continuam funcionando.
# É API key de projeto (não service account), com a Cloud Billing API habilitada.
GCP_BILLING_API_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","https://dev.oneshift.com.br","https://oneshift.com.br"]

# ─── RabbitMQ / Celery ────────────────────────────────────────────────────
CELERY_BROKER_URL=amqp://oneshift:oneshift@localhost:5672/oneshift
CELERY_RESULT_BACKEND=rpc://

# ─── Encryption envelope (cifrar credenciais cloud no DB) ─────────────────
CLOUD_CREDS_FERNET_KEY=

# ─── Cloud credentials (em prod: Vault) ───────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GCP_SERVICE_ACCOUNT_JSON=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
OCI_USER_OCID=
OCI_TENANCY_OCID=
OCI_FINGERPRINT=
OCI_REGION=

# ─── Gemini (LLM para análise de migração) ─────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── OpenRouter (LLM alternativo) ───────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
